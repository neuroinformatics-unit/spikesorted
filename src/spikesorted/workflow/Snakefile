"""The spikesorted workflow.

Run through the ``spikesorted`` command, which writes the run config this
workflow reads:

- ``output_path``: the subject folder all outputs are written below.
- ``config_path``: the user's pipeline config.
- ``sessions``: session name to recording path.

Each session's shanks are found when the workflow loads, from the recording's
``group`` property. Rule inputs and outputs come from each step's
``get_input_paths()`` and ``get_output_path()``, so Snakemake checks the same
paths the steps use.
"""

import re

import matplotlib
import yaml

from spikesorted.steps.artifact_detection import ArtifactDetectionStep
from spikesorted.steps.bad_channel_detection import (
    BadChannelDetectionStep,
    BadChannelUnionStep,
)
from spikesorted.steps.bad_channel_detection.utils import (
    get_bad_channel_ids_filepath,
    get_bad_channel_labels_filepath,
)
from spikesorted.steps.combine_sessions_step import CombineSessionsStep
from spikesorted.steps.input_data_step import InputDataStep
from spikesorted.steps.preprocessing_step import PreprocessingStep
from spikesorted.steps.raw_data_quality_metrics_step import RawDataQualityMetricsStep
from spikesorted.steps.sorting import SortingStep
from spikesorted.utils.utils import load_pipeline_config

# Snakemake runs jobs in worker threads, where an interactive backend such as
# Tk fails when a step saves a plot.
matplotlib.use("Agg")

OUTPUT_PATH = config["output_path"]
CONFIG_PATH = config["config_path"]
PIPELINE_CONFIG = load_pipeline_config(CONFIG_PATH)

RECORDING_PATHS = config["sessions"]
SESSION_NAMES = tuple(sorted(RECORDING_PATHS))

# Only reads recording headers. On a cluster this runs again in every job,
# because each job re-reads the Snakefile.
MANIFEST = []
for session_name in SESSION_NAMES:
    recording_path = RECORDING_PATHS[session_name]
    for shank_id in InputDataStep.get_shank_ids(recording_path):
        MANIFEST.append({"session": session_name, "shank": shank_id})

SHANK_IDS = sorted({manifest_entry["shank"] for manifest_entry in MANIFEST})

COMBINE_SESSIONS = "combine_sessions" in PIPELINE_CONFIG


wildcard_constraints:
    session="|".join(re.escape(session_name) for session_name in SESSION_NAMES),
    shank="[^/]+",


def as_pattern(path):
    """Return a path as a forward-slash string for Snakemake.

    Parameters
    ----------
    path
        The path to convert.

    Returns
    -------
    path_pattern
        The path with forward slashes.
    """
    return path.as_posix()


def check_bad_channel_union_sessions(shank_id):
    """Check a shank's bad-channel union was made from the requested sessions.

    Does nothing unless the config has both ``bad_channel_detection`` and
    ``combine_sessions``.

    Parameters
    ----------
    shank_id
        Shank ID.
    """
    if "bad_channel_detection" in PIPELINE_CONFIG and COMBINE_SESSIONS:
        sessions_path = (
            BadChannelUnionStep.get_output_path(OUTPUT_PATH, shank_id)
            / "sessions.yaml"
        )
        with sessions_path.open(encoding="utf-8") as file:
            union_sessions = yaml.safe_load(file)["sessions"]
        if sorted(union_sessions) != list(SESSION_NAMES):
            raise ValueError(
                f"Bad-channel union sessions {union_sessions} do not match "
                f"the requested sessions {list(SESSION_NAMES)}."
            )


def get_targets():
    """Return the final outputs for every session shank.

    Returns
    -------
    target_paths
        The output paths ``rule all`` requests.
    """
    target_paths = []

    for manifest_entry in MANIFEST:
        target_paths.append(
            as_pattern(
                InputDataStep.get_recording_json_path(
                    OUTPUT_PATH, manifest_entry["session"], manifest_entry["shank"]
                )
            )
        )

    if "bad_channel_detection" in PIPELINE_CONFIG:
        for manifest_entry in MANIFEST:
            target_paths.append(
                as_pattern(
                    get_bad_channel_ids_filepath(
                        BadChannelDetectionStep.get_output_path(
                            OUTPUT_PATH, manifest_entry["session"], manifest_entry["shank"]
                        )
                    )
                )
            )

        if COMBINE_SESSIONS:
            for shank_id in SHANK_IDS:
                target_paths.append(
                    as_pattern(
                        get_bad_channel_ids_filepath(
                            BadChannelUnionStep.get_output_path(OUTPUT_PATH, shank_id)
                        )
                    )
                )

    if "raw_data_quality_metrics" in PIPELINE_CONFIG:
        for manifest_entry in MANIFEST:
            target_paths.append(
                as_pattern(
                    RawDataQualityMetricsStep.get_output_path(
                        OUTPUT_PATH, manifest_entry["session"], manifest_entry["shank"]
                    )
                )
            )

    if "artifact_detection" in PIPELINE_CONFIG:
        for manifest_entry in MANIFEST:
            target_paths.append(
                as_pattern(
                    ArtifactDetectionStep.get_output_path(
                        OUTPUT_PATH, manifest_entry["session"], manifest_entry["shank"]
                    )
                )
            )

    for manifest_entry in MANIFEST:
        target_paths.append(
            as_pattern(
                PreprocessingStep.get_output_path(
                    OUTPUT_PATH, manifest_entry["session"], manifest_entry["shank"]
                )
            )
        )

    if COMBINE_SESSIONS:
        for shank_id in SHANK_IDS:
            target_paths.append(
                as_pattern(CombineSessionsStep.get_output_path(OUTPUT_PATH, shank_id))
            )

    if COMBINE_SESSIONS:
        for shank_id in SHANK_IDS:
            target_paths.append(
                as_pattern(
                    SortingStep.get_output_path(
                        OUTPUT_PATH, CombineSessionsStep.combined_session_name, shank_id
                    )
                )
            )
    else:
        for manifest_entry in MANIFEST:
            target_paths.append(
                as_pattern(
                    SortingStep.get_output_path(
                        OUTPUT_PATH, manifest_entry["session"], manifest_entry["shank"]
                    )
                )
            )

    return target_paths


rule all:
    input:
        get_targets(),
    default_target: True


include: "input_data.smk"
include: "bad_channel_detection.smk"
include: "raw_data_quality_metrics.smk"
include: "artifact_detection.smk"
include: "preprocessing.smk"
include: "combine_sessions.smk"
include: "sorting.smk"
